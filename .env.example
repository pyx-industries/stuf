# OIDC Configuration
OIDC_BASE_URL=http://zitadel:8080
# OIDC_ISSUER_URL, OIDC_ISSUER_HOST, OIDC_VALID_AUDIENCES, OIDC_SPA_CLIENT_ID
# and the SPA's OIDC_AUTHORITY and OIDC_CLIENT_ID come from
# .zitadel-bootstrap/generated.env, which the api and spa containers read when
# they start. Set them here only to override it.

# S3-compatible object storage. The API reads the S3_* settings; in development
# the access key and secret are also RustFS's own credentials.
# S3_ENDPOINT_URL is for running the API outside compose (compose sets
# http://rustfs:9000); leave it unset for AWS itself.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET_NAME=stuf-uploads
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# API Configuration
API_PORT=8000
API_URL=http://localhost:8000

# SPA Configuration
SPA_PORT=3000
