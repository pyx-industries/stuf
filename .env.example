# OIDC Configuration (set from .zitadel-bootstrap/generated.env after provisioning)
OIDC_ISSUER_URL=http://localhost:8080
OIDC_BASE_URL=http://zitadel:8080
OIDC_ISSUER_HOST=localhost:8080
OIDC_VALID_AUDIENCES=

# Development object store (RustFS); the API reads the MINIO_* names
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# API Configuration
API_PORT=8000
API_URL=http://localhost:8000

# SPA Configuration
SPA_PORT=3000
